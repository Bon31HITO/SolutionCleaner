<Window x:Class="SolutionCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SolutionCleaner"
        Title="ソリューション ソースコード エクストラクター"
        Height="400"
        Width="650"
        MinHeight="360"
        MinWidth="550"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- コピー元ソリューションフォルダ -->
        <GroupBox Grid.Row="0" Header="ソリューション フォルダ (入力)" Margin="0,0,0,12">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding SourceDirectoryPath, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding CanSelectDirectory}"
                         VerticalContentAlignment="Center"
                         Margin="0,0,8,0" />
                <Button Grid.Column="1"
                        Content="参照..."
                        Command="{Binding SelectSourceDirectoryCommand}"
                        Width="80"
                        Height="28" />
            </Grid>
        </GroupBox>

        <!-- コピー先出力フォルダ -->
        <GroupBox Grid.Row="1" Header="アウトプット フォルダ (出力)" Margin="0,0,0,16">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding DestinationDirectoryPath, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding CanSelectDirectory}"
                         VerticalContentAlignment="Center"
                         Margin="0,0,8,0" />
                <Button Grid.Column="1"
                        Content="参照..."
                        Command="{Binding SelectDestinationDirectoryCommand}"
                        Width="80"
                        Height="28" />
            </Grid>
        </GroupBox>

        <!-- アクションボタン -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,16">
            <Button Content="キャンセル"
                    Command="{Binding CancelCommand}"
                    Width="100"
                    Height="32"
                    Margin="0,0,8,0" />
            <Button Content="コピー開始"
                    Command="{Binding StartCopyCommand}"
                    Width="110"
                    Height="32" />
        </StackPanel>

        <!-- 進捗状況表示領域 -->
        <Border Grid.Row="3" Background="#FFF5F5F5" BorderBrush="#FFDDDDDD" BorderThickness="1" CornerRadius="4" Padding="12">
            <StackPanel VerticalAlignment="Center">
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Right" />
                </Grid>
                <ProgressBar Value="{Binding ProgressPercentage, Mode=OneWay}" Minimum="0" Maximum="100" Height="18" Margin="0,0,0,6" />
                <TextBlock Text="{Binding CurrentFileName}" TextTrimming="CharacterEllipsis" Foreground="#FF666666" />
            </StackPanel>
        </Border>

        <!-- 除外ルール説明 -->
        <TextBlock Grid.Row="4"
                   Margin="0,8,0,0"
                   FontSize="11"
                   Foreground="#FF888888"
                   Text="※ . で始まるフォルダ・ファイル (.vs, .git, .editorconfig等)、および bin / obj フォルダは自動的に除外されます。" />
    </Grid>
</Window>